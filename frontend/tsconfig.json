{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@internal/design-system/components": [
        "../packages/design-system/src/components/index"
      ],
      "@internal/design-system/components/*": [
        "../packages/design-system/src/components/*"
      ],
      "@internal/design-system/primitives": [
        "../packages/design-system/src/primitives/index"
      ],
      "@internal/design-system/primitives/*": [
        "../packages/design-system/src/primitives/*"
      ],
      "@internal/design-system/tokens": [
        "../packages/design-system/src/tokens/index"
      ],
      "@internal/design-system/tokens/*": [
        "../packages/design-system/src/tokens/*"
      ],
      "@internal/design-system/style": [
        "../packages/design-system/src/styles/index"
      ],
      "@internal/design-system/style/*": [
        "../packages/design-system/src/styles/*"
      ],
      "@internal/design-system/patterns": [
        "../packages/design-system/src/patterns/index"
      ],
      "@internal/design-system/patterns/*": [
        "../packages/design-system/src/patterns/*"
      ],
      "@compo/*": ["./src/components/*"],
      "@icons/*": ["./src/icons/*"],
      "@hooks/*": ["./src/shared/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@public/*": ["./public/*"],
      "@tests/*": ["./tests/*"],
      "@root/prisma/*": ["./prisma/*"],
      "@root/*": ["./*"],
      "@entities/*": ["./src/entities/*"],
      "@dashboard/*": ["./src/app/dashboard/*"],
      "@scripts/*": ["./scripts/*"],
      "@style/*": ["./src/style/*"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "esm": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    "scripts/seed.mjs",
    "./type.d.ts",
    "scripts/generateTransactions.mjs",
    "eslint.config.mjs",
    ".next/dev/types/**/*.ts",
    "../packages/design-system/src/**/*.ts",
    "../packages/design-system/src/**/*.tsx"
  ],
  "exclude": [
    "./node_modules",
    "storybook-static",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "../packages/design-system/src/**/*.stories.ts",
    "../packages/design-system/src/**/*.stories.tsx"
  ]
}
