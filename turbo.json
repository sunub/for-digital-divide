{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "SUNUB_POSTGRES_URL",
    "SUNUB_POSTGRES_URL_NON_POOLING",
    "SUNUB_POSTGRES_PRISMA_URL",
    "SUNUB_POSTGRES_USER",
    "SUNUB_POSTGRES_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format": {}
  }
}
