{
  "name": "@internal/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && tsx ./build.ts",
    "build:mcp": "tsx scripts/build-mcp-data.ts",
    "lint": "pnpm exec biome lint --write",
    "ci": "pnpm exec biome ci",
    "format": "pnpm exec biome format --write",
    "check": "pnpm exec biome check --write",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "sideEffects": [
    "**/*.css.ts",
    "**/*.css",
    "./dist/**/*.css"
  ],
  "exports": {
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.js",
      "require": "./dist/styles/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "@vanilla-extract/css": "^1.17.5",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "clsx": "^2.1.1",
    "glob": "^13.0.6",
    "motion": "^12.4.3",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "10.4.5",
    "@storybook/addon-docs": "10.4.5",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "10.4.5",
    "@storybook/react-vite": "10.4.5",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "lightningcss": "^1.32.0",
    "playwright": "^1.61.0",
    "storybook": "10.4.5",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3"
  }
}
