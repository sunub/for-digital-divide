generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  pattern  String[]
  length   Int
  username String   @unique
  id       Int      @id @default(autoincrement())
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinHash {
  username String   @unique
  hash     Json
  id       Int      @id @default(autoincrement())
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinNumbers {
  numbers  String[]
  username String   @unique
  id       Int      @id @default(autoincrement())
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model Post {
  id       String   @id
  slug     String   @unique
  category String
  date     DateTime
  summary  String
  title    String
  Tags     Tags[]

  @@index([category, date])
  @@index([slug])
}

model Redirects {
  id          String   @id
  source      String
  destination String
  createdAt   DateTime @default(now())

  @@unique([source, destination])
  @@index([source])
}

model Tags {
  id       String @id
  name     String @db.VarChar(30)
  postSlug String
  Post     Post   @relation(fields: [postSlug], references: [slug])
}

model UserInfo {
  id         String      @id @default(cuid())
  username   String      @unique
  sessionId  String?     @unique @map("session_id")
  Pattern    Pattern?
  PinHash    PinHash?
  PinNumbers PinNumbers?
}

model account_types {
  code String  @id @db.VarChar(20)
  name String  @db.VarChar(50)
  note String?
}

model accounts {
  account_number                                                  BigInt         @id @unique(map: "unique_account_number")
  user_id                                                         Int
  account_type                                                    String         @default("CHECKING") @db.VarChar(20)
  balance                                                         Decimal        @default(0) @db.Decimal(15, 2)
  created_at                                                      DateTime       @default(now()) @db.Timestamp(6)
  users                                                           users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  transactions                                                    transactions[]
  transactions_transactions_counterparty_account_numberToaccounts transactions[] @relation("transactions_counterparty_account_numberToaccounts")

  @@index([user_id], map: "idx_accounts_user_id")
}

model auth_methods {
  auth_method_id Int      @id @default(autoincrement())
  user_id        Int
  method         String   @db.VarChar(50)
  credential     String   @db.Text
  provider       String?  @db.VarChar(50)
  provider_uid   String?  @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  users          users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, method], map: "auth_methods_user_method_unique")
  @@index([provider_uid, provider], map: "auth_methods_provider_uid_provider_index")
}

model transaction_types {
  code String  @id @db.VarChar(20)
  name String  @db.VarChar(50)
  note String?
}

model transactions {
  transaction_id                                              BigInt    @id @default(autoincrement())
  account_number                                              BigInt
  amount                                                      Decimal   @db.Decimal(15, 2)
  transaction_type                                            String    @db.VarChar(20)
  description                                                 String?
  occurred_at                                                 DateTime  @default(now()) @db.Timestamp(6)
  counterparty_account_number                                 BigInt?
  accounts                                                    accounts  @relation(fields: [account_number], references: [account_number], onDelete: Cascade, onUpdate: NoAction)
  accounts_transactions_counterparty_account_numberToaccounts accounts? @relation("transactions_counterparty_account_numberToaccounts", fields: [counterparty_account_number], references: [account_number], onUpdate: NoAction)

  @@index([account_number], map: "idx_transactions_account")
}

model users {
  user_id      Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  session_id   String?        @db.VarChar(255)
  email        String         @unique @db.VarChar(254)
  accounts     accounts[]
  auth_methods auth_methods[]

  @@index([session_id], map: "idx_users_session_id")
  @@index([email], map: "idx_users_email")
  @@index([name], map: "idx_users_name")
}
