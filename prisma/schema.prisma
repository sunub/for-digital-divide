// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pattern {
  id       Int      @id @default(autoincrement())
  pattern  String[]
  length   Int
  username String   @unique
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinHash {
  id       Int      @id @default(autoincrement())
  username String   @unique
  hash     Json
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinNumbers {
  id       Int      @id @default(autoincrement())
  numbers  String[]
  username String   @unique
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model Post {
  id       String   @id
  slug     String   @unique
  category String
  date     DateTime
  summary  String
  title    String
  Tags     Tags[]

  @@index([category, date])
  @@index([slug])
}

model Redirects {
  id          String   @id
  source      String
  destination String
  createdAt   DateTime @default(now())

  @@unique([source, destination])
  @@index([source])
}

model Tags {
  id       String @id
  name     String @db.VarChar(30)
  postSlug String
  Post     Post   @relation(fields: [postSlug], references: [slug])
}

model UserInfo {
  id         String      @id @default(cuid())
  username   String      @unique
  sessionId  String?     @unique @map("session_id")
  Pattern    Pattern?
  PinHash    PinHash?
  PinNumbers PinNumbers?
}
